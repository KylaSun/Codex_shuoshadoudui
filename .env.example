# Copy to .env (ignored by git); npm start loads it on Node.js 20.12+.
# Server only: never paste the real key into src/, HTML, tests or GitHub.
OPENAI_API_KEY=
RECIPE_VISION_MODEL=gpt-5.4-mini
# Full Responses API URL; a custom provider must support input_image + strict JSON schema.
RECIPE_VISION_ENDPOINT=https://api.openai.com/v1/responses
HOST=127.0.0.1
PORT=5173
